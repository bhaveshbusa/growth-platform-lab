{
  "name": "growth-platform-lab",
  "version": "0.1.0",
  "private": true,
  "description": "Learning project for observability, customer data platform (CDP) mechanics, and product analytics.",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "start:event-gateway:dev": "nest start event-gateway --watch",
    "start:event-gateway": "node dist/apps/event-gateway/main.js",
    "build": "nest build event-gateway",
    "lint": "eslint \"apps/**/*.ts\" \"docs/**/*.ts\"",
    "format": "prettier --write \"apps/**/*.ts\" \"docs/**/*.{md,ts,yaml}\" \"learning/**/*.{json,md}\" \"*.{json,md,yml}\"",
    "format:check": "prettier --check \"apps/**/*.ts\" \"docs/**/*.{md,ts,yaml}\" \"learning/**/*.{json,md}\" \"*.{json,md,yml}\"",
    "test": "jest",
    "test:e2e": "jest --config apps/event-gateway/test/jest-e2e.json",
    "learning:ui": "node tools/learning-mcp/ui.js"
  },
  "dependencies": {
    "@nestjs/common": "11.1.28",
    "@nestjs/config": "4.0.2",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.1.28",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "26.1.1",
    "@types/supertest": "7.2.1",
    "eslint": "10.7.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.7.0",
    "jest": "30.4.2",
    "prettier": "3.9.5",
    "source-map-support": "0.5.21",
    "supertest": "7.2.2",
    "ts-jest": "29.4.11",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.64.0"
  }
}
